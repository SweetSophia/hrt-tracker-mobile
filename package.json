{
  "name": "oyama-s-hrt-tracker",
  "private": true,
  "version": "1.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "node scripts/bundle-size.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "crossval:pk": "python3 scripts/pk_crossval.py",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "wrangler:dev": "npm run build && wrangler dev",
    "wrangler:migrate:local": "node docker/reconcile.mjs --apply hrt-tracker-prod --local",
    "wrangler:migrate:remote": "node docker/reconcile.mjs --apply hrt-tracker-prod --remote",
    "wrangler:migrate:reconcile": "node docker/reconcile.mjs hrt-tracker-prod --remote",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri": "tauri",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "android:sync": "node scripts/mobile/sync.mjs",
    "mobile:doctor": "node scripts/mobile/doctor.mjs --android",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "build:mobile:probe": "vite build --config vite.mobile.config.ts --mode mobile-probe",
    "android:sync:probe": "node scripts/mobile/sync.mjs --probe",
    "build:mobile:storage": "vite build --config vite.mobile.config.ts --mode mobile-storage-qualification",
    "android:sync:storage": "node scripts/mobile/sync.mjs --storage-qualification",
    "build:mobile:offline-beta": "vite build --config vite.mobile.config.ts --mode mobile-offline-beta",
    "test:e2e:mobile:storage": "playwright test --config playwright.storage.config.ts",
    "test:mobile:artifacts": "HRT_MOBILE_ARTIFACTS=1 vitest run tests/mobile/artifactPolicy.test.ts",
    "test:mobile:renderer-replay": "HRT_RENDERER_REPLAY=1 vitest run tests/mobile/rendererAttributionCli.test.ts",
    "test:mobile:upstream-policy": "HRT_UPSTREAM_POLICY=1 vitest run tests/mobile/upstreamPolicy.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.14.0",
    "jose": "^6.2.17",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.9",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "openpgp": "^6.3.2",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/cli": "8.6.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^1.6.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
